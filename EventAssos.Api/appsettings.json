{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:3000",
      "http://localhost:5500"
    ]
  },
  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": ""
  },  
  "AppSettings" : {
    "ClientUrl" : "http://localhost:4200"
  },
  "ConnectionStrings": {
    "Default": "",
    "AzureBlobStorage": "",
    "ServiceBusConnectionString": ""
  },
  "Azure": {
    "QueueName": "email-queue"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.AzureBlobStorage" ],
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ],
    "Properties": { "Application": "EventAssos.API" }
  }
}
